[gd_scene format=3 uid="uid://bxm30vlxht6fm"]

[sub_resource type="GDScript" id="GDScript_1v73g"]
script/source = "
extends Node

const LISTEN_PORT: int = 4242

var udp := PacketPeerUDP.new()

# Most recent normalized sensor vector.
var sensor_vector: Vector3 = Vector3.ZERO

func _ready() -> void:
	var result := udp.bind(LISTEN_PORT, \"0.0.0.0\")

	if result != OK:
		push_error(\"Could not bind UDP port %d\" % LISTEN_PORT)
		return

	print(\"Wand receiver listening on UDP port \", LISTEN_PORT)


func _process(_delta: float) -> void:
	while udp.get_available_packet_count() > 0:
		var packet: PackedByteArray = udp.get_packet()
		var message := packet.get_string_from_utf8().strip_edges()
		var components := message.split(\",\")

		if components.size() != 3:
			continue

		var x := components[0].to_float()
		var y := components[1].to_float()
		var z := components[2].to_float()

		sensor_vector = Vector3(x, y, z)

		if sensor_vector.length_squared() > 0.001:
			sensor_vector = sensor_vector.normalized()

			# Temporary diagnostic output.
			# Remove this print after testing.
			print(\"Sensor vector: \", sensor_vector)
"

[node name="WandReceiver" type="Node" unique_id=748435810]
script = SubResource("GDScript_1v73g")
